model ServiceCategory {
  id          String       @id @default(cuid())
  tenantId    String
  name        String
  description String?
  sortOrder   Int          @default(0)
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  services    Service[]

  @@unique([tenantId, name])
  @@map("service_categories")
}

model Service {
  id              String       @id @default(cuid())
  tenantId        String
  name            String
  description     String?
  categoryId      String?
  category        ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  durationMinutes Int
  basePrice       Decimal      @db.Decimal(12, 2)
  taxRate         Decimal      @default(0) @db.Decimal(5, 2)
  color           String?
  status          RecordStatus @default(ACTIVE)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  branchServices    BranchService[]
  therapistServices TherapistService[]
  consumables       ServiceConsumable[]
  appointments      Appointment[]
  queueEntries      QueueEntry[]
  sessions          TherapySession[]
  packageItems      PackageItem[]
  customerPackageItems CustomerPackageItem[]

  @@index([tenantId, status])
  @@map("services")
}

model BranchService {
  id              String   @id @default(cuid())
  tenantId        String
  branchId        String
  serviceId       String
  branch          Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  service         Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  price           Decimal? @db.Decimal(12, 2)
  durationMinutes Int?
  isActive        Boolean  @default(true)

  @@unique([branchId, serviceId])
  @@index([tenantId])
  @@map("branch_services")
}

model ServiceConsumable {
  id        String  @id @default(cuid())
  tenantId  String
  serviceId String
  productId String
  quantity  Decimal @db.Decimal(12, 3)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([serviceId, productId])
  @@map("service_consumables")
}

enum CommissionType {
  PERCENTAGE
  FIXED_PER_SESSION
  TIERED
  NONE
}

model Therapist {
  id              String         @id @default(cuid())
  tenantId        String
  userId          String?        @unique
  user            User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  name            String
  phone           String?
  employeeCode    String
  specialization  String?
  joiningDate     DateTime?      @db.Date
  primaryBranchId String?
  status          RecordStatus   @default(ACTIVE)
  commissionType  CommissionType @default(NONE)
  commissionValue Decimal        @default(0) @db.Decimal(12, 2)
  commissionTiers Json?
  color           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  services     TherapistService[]
  schedules    TherapistSchedule[]
  exceptions   TherapistScheduleException[]
  appointments Appointment[]
  queueEntries QueueEntry[]
  sessions     TherapySession[]
  commissions  TherapistCommission[]

  @@unique([tenantId, employeeCode])
  @@index([tenantId, status])
  @@map("therapists")
}

model TherapistService {
  therapistId String
  serviceId   String
  tenantId    String
  therapist   Therapist @relation(fields: [therapistId], references: [id], onDelete: Cascade)
  service     Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([therapistId, serviceId])
  @@map("therapist_services")
}

model TherapistSchedule {
  id          String    @id @default(cuid())
  tenantId    String
  therapistId String
  branchId    String
  dayOfWeek   Int
  startTime   String
  endTime     String
  therapist   Therapist @relation(fields: [therapistId], references: [id], onDelete: Cascade)

  @@index([tenantId, branchId, dayOfWeek])
  @@index([therapistId])
  @@map("therapist_schedules")
}

enum ScheduleExceptionType {
  LEAVE
  HOLIDAY
  SPECIAL_SHIFT
  UNAVAILABLE
}

model TherapistScheduleException {
  id          String                @id @default(cuid())
  tenantId    String
  therapistId String
  branchId    String?
  date        DateTime              @db.Date
  type        ScheduleExceptionType
  reason      String?
  startTime   String?
  endTime     String?
  createdAt   DateTime              @default(now())
  therapist   Therapist             @relation(fields: [therapistId], references: [id], onDelete: Cascade)

  @@index([therapistId, date])
  @@map("therapist_schedule_exceptions")
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
  CANCELLED
}

model TherapistCommission {
  id             String           @id @default(cuid())
  tenantId       String
  branchId       String
  therapistId    String
  sessionId      String           @unique
  baseAmount     Decimal          @db.Decimal(12, 2)
  commissionType CommissionType
  rate           Decimal          @db.Decimal(12, 2)
  amount         Decimal          @db.Decimal(12, 2)
  status         CommissionStatus @default(PENDING)
  createdAt      DateTime         @default(now())
  paidAt         DateTime?
  therapist      Therapist        @relation(fields: [therapistId], references: [id])

  @@index([tenantId, therapistId, createdAt])
  @@map("therapist_commissions")
}
