NODE_ENV=development
PORT=4000
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000

DATABASE_URL=postgresql://therapyos:therapyos@localhost:5434/therapyos?schema=public
REDIS_URL=redis://localhost:6380

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Run BullMQ workers + outbox relay inside the API process (handy for local dev)
RUN_WORKER_IN_API=true

# Object storage (SeaweedFS locally, S3/R2/Azure-compatible in prod)
STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=therapyos
S3_ACCESS_KEY=any
S3_SECRET_KEY=any
S3_FORCE_PATH_STYLE=true

# Email (Mailpit locally)
EMAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="TherapyOS <no-reply@therapyos.local>"

# SMS: mock | msg91 | twilio
SMS_PROVIDER=mock

# WhatsApp: mock | cloud
WHATSAPP_PROVIDER=mock
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Payments: mock | razorpay
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Google login
GOOGLE_CLIENT_ID=

# AI assistant: mock | openai
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Observability
LOG_LEVEL=info
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Platform super admin bootstrap (used by seed)
PLATFORM_ADMIN_EMAIL=admin@rkyves.com
PLATFORM_ADMIN_PASSWORD=Admin@12345
